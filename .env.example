# ===================================================
# GCP Debian 12 Honeypot & SOC Dashboard Configuration
# ===================================================

# Low-risk port strategy: Expose Cowrie on 2222, keep 22 for system SSH
COWRIE_PORT=2222

# Fake hostname presented by the honeypot
COWRIE_HOSTNAME=srv-prod-debian12

# Dashboard Web UI & API port
WEB_PORT=8080

# Honeypot Virtual Node Metadata (Desensitized name & anchor coordinates)
SERVER_NAME=Honeypot-Node-01
SERVER_LAT=1.3521
SERVER_LON=103.8198
SERVER_CITY=Singapore
SERVER_COUNTRY=SG

# Host Public IP (Optional: provide your GCP instance public IP to ensure complete masking)
HOST_REAL_IP=

# Disk Retention (Days to retain SQLite events and sample binaries on 10GB disk)
RETENTION_DAYS=7

# Demo Mode (true: generates realistic botnet attack stream for testing)
DEMO_MODE=false
